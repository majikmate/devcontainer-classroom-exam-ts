// Classroom devcontainer for TypeScript / Deno exams.
// devcontainer-core and the layer deno add their own settings (user dev, zsh,
// theme, Markdown preview, git, SSH start, Deno extension and test arguments);
// this file adds the exam settings. The release workflow writes all of them
// into the image label devcontainer.metadata.
// AI features and coding assistance are turned off.
// Documentation: https://github.com/majikmate/devcontainer-classroom-exam-ts#readme
{
  "name": "Classroom Environment for TypeScript Exams",
  "build": {
    "dockerfile": "Dockerfile"
  },
  // apt in the terminal does not ask questions
  "containerEnv": {
    "DEBIAN_FRONTEND": "noninteractive"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        // Formatter (the extension contains Prettier; no Node.js needed in the image)
        "esbenp.prettier-vscode",
        // Disable extensions that might interfere
        "-github.vscode-pull-request-github",
        "-github.vscode-github-actions",
        "-ms-vscode-remote.remote-containers",
        "-dbaeumer.vscode-eslint"
        // Copilot is not listed here: Copilot Chat is built into VS Code and
        // cannot be uninstalled. "chat.disableAIFeatures" below turns it off.
      ],
      "settings": {
        // ── Extensions ────────────────────────────────────────────────────────────
        "extensions.ignoreRecommendations": true,

        // ── Workbench ─────────────────────────────────────────────────────────────
        // Prevent startup and install-triggered welcome surfaces from opening.
        "workbench.startupEditor": "none",
        "workbench.welcomePage.walkthroughs.openOnInstall": false,
        // Hide the secondary side bar (chat). VS Code applies this default only
        // the first time a workspace is opened.
        "workbench.secondarySideBar.defaultVisibility": "hidden",

        // ── Formatting: Prettier only, standard Prettier style ───────────────────
        // Prettier is the default formatter for all languages, so VS Code never
        // uses the Deno formatter.
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        // Same indentation as the standard Prettier output
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.detectIndentation": false,

        // ── Hide config folders from students ─────────────────────────────────────
        "files.exclude": {
          "**/.devcontainer": true,
          "**/.github": true,
          "**/.vscode": true
        },

        // ── AI features ───────────────────────────────────────────────────────────
        // The complete switch: hides all AI and chat UI and disables the built-in
        // Copilot extension (chat, inline suggestions, next edit suggestions).
        // Note: when this value comes from the container settings, VS Code disables
        // Copilot in the student's local VS Code profile as well. To use Copilot
        // again outside the exam, set "chat.disableAIFeatures" to false in the
        // local user settings.
        "chat.disableAIFeatures": true,
        // Additional layers, in case "chat.disableAIFeatures" is changed
        "chat.agent.enabled": false,
        "chat.agentsControl.enabled": "hidden",
        "github.copilot.enable": { "*": false },
        "github.copilot.nextEditSuggestions.enabled": false,

        // ── Suppress native IntelliSense completions ──────────────────────────────
        // Disables the suggestion popup in code, comments, and strings as you type
        "editor.quickSuggestions": {
          "other": "off",
          "comments": "off",
          "strings": "off"
        },
        // Prevents suggestions from appearing after trigger characters like ".", "(", etc.
        "editor.suggestOnTriggerCharacters": false,
        // Disables suggestions derived from words found in open files
        "editor.wordBasedSuggestions": "off",
        // Disables ghost text (inline) completions
        "editor.inlineSuggest.enabled": false,
        // Disables function signature/parameter hint tooltips
        "editor.parameterHints.enabled": false,
        // Removes snippet entries from the suggestion list
        "editor.snippetSuggestions": "none",
        // Prevents Enter from accidentally accepting a suggestion
        "editor.acceptSuggestionOnEnter": "off",
        // Hides the lightbulb quick fix widget
        "editor.lightbulb.enabled": "off",

        // ── Exam Color customization ───────────────────────────────────────────────
        // Customizes the color theme for the exam environment.
        "workbench.colorCustomizations": {
          "titleBar.activeBackground": "#61dafb",
          "titleBar.activeForeground": "#15202b",
          "titleBar.inactiveBackground": "#61dafb99",
          "titleBar.inactiveForeground": "#15202b99"
        }
      }
    }
  }
}
